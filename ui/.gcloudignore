# Files NOT uploaded to Cloud Build when running
# `gcloud run deploy --source=ui`. Without this file, gcloud falls back to
# the source dir's .gitignore. Defining .gcloudignore explicitly avoids
# any ambiguity (in particular ensures .env.production IS uploaded).

node_modules
.next
.git
.gitignore
.dockerignore
README.md
*.log

# Local-only env files; .env.production is generated by the workflow
# right before deploy and IS expected to be uploaded.
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
