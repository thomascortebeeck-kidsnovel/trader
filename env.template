# Copy to .env for local use. Never commit .env.
# In claude.ai/code/routines, set these per-environment instead — one
# environment per bot, each with its own Alpaca paper account keys.

# ---------------------------------------------------------------------------
# Alpaca (paper) — per-bot keys
# ---------------------------------------------------------------------------
# Decision (operator): three separate Alpaca paper accounts, one per bot,
# so P/L attribution is unambiguous. Create 3 paper accounts at
# alpaca.markets; copy each account's key + secret into the matching
# routine environment in claude.ai/code/routines.
#
# The routines themselves only ever read ALPACA_API_KEY / ALPACA_SECRET_KEY.
# The variables below are for documentation + local .env convenience.

# --- Bot 1 (general) ---
GENERAL_ALPACA_API_KEY=
GENERAL_ALPACA_SECRET_KEY=

# --- Bot 2 (day-trader-kraken) ---
KRAKEN_ALPACA_API_KEY=
KRAKEN_ALPACA_SECRET_KEY=

# --- Bot 3 (news-based) ---
NEWS_ALPACA_API_KEY=
NEWS_ALPACA_SECRET_KEY=

# --- What the routines actually consume (set in claude.ai/code/routines env) ---
# In each routine environment, set exactly:
#   ALPACA_API_KEY     = <that bot's paper key>
#   ALPACA_SECRET_KEY  = <that bot's paper secret>
#   ALPACA_BASE_URL    = https://paper-api.alpaca.markets
#   ALPACA_DATA_URL    = https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ---------------------------------------------------------------------------
# Research — shared across all bots
# ---------------------------------------------------------------------------
PERPLEXITY_API_KEY=

# ---------------------------------------------------------------------------
# News (secondary) — shared across all bots
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Notifications — single ClickUp workspace, single task for all bots
# ---------------------------------------------------------------------------
# Decision (operator): one ClickUp task shared by all three bots.
# Messages are prefixed with [GENERAL] / [KRAKEN] / [NEWS] so the
# thread is still readable. The task ID below is non-secret (anyone
# without the API key can't post to it anyway).
CLICKUP_API_KEY=
CLICKUP_TASK_ID=869cyx7a5

# ---------------------------------------------------------------------------
# Safety — paper by default everywhere
# ---------------------------------------------------------------------------
# Leave false. Each bot's strategy.md documents how to graduate to live.
LIVE_MODE=false
